{
  "name": "wpfda-backend",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "./mvnw -B -q dependency:go-offline",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "API" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "redhat.vscode-yaml"
      ]
    }
  }
}
